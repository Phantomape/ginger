# OHLCV warehouse (hot + cold): written/merged every daily run via
# `python quant/ohlcv_warehouse.py merge-hot`. NEITHER tier is committed.
# The hot tier must not be LFS-tracked (the auto-committer/git-LFS held it open
# during daily writes -> SQLite "disk I/O error", stalling OHLCV accumulation).
# The cold tier (~720MB) was previously committed via LFS, but each daily merge
# produced a fresh ~755MB LFS object that exhausted the repo's LFS budget and
# blocked pushes; it is regenerable from the OHLCV sources, so it is no longer
# tracked. Rebuild/share it out-of-band rather than through git.
data/warehouse/warehouse_main.sqlite
data/warehouse/warehouse_main.sqlite-journal
data/warehouse/warehouse_main.sqlite-wal
data/warehouse/warehouse_main.sqlite-shm
data/warehouse/warehouse_main_hot.sqlite
data/warehouse/warehouse_main_hot.sqlite-journal
data/warehouse/warehouse_main_hot.sqlite-wal
data/warehouse/warehouse_main_hot.sqlite-shm

# exp-20260613-007: SEC 13F source zips are ~100MB and regenerable from SEC on
# demand; only the aggregated holdings_*.json + latest.json are tracked.
data/non_ohlcv/sec13f_institutional/source_cache/

# exp-20260616-020: raw FINRA biweekly short-interest CSVs are ~86MB after the
# historical backfill and regenerable from the FINRA CDN on demand; only the
# parsed rows.json + source_files.json manifest are tracked.
data/non_ohlcv/finra_short_interest/source_cache/

# exp-20260613-023: broad-universe SEC backfill row dumps are ~1.1GB and
# regenerable from the data/cache/sec/* caches; only the *_summary.json stats
# are tracked.
data/experiments/*/backfill_*_rows.jsonl
data/experiments/*/refresh_*_rows.jsonl

# docs/experiment_log.jsonl retired: derived aggregate of experiments/logs/*.json
# (source of truth), no longer written; rebuild via scripts/compact_experiment_records.py.
docs/experiment_log.jsonl

# run.py singleton lock (runtime)
data/run.lock
data/run.lock.pid
data/runtime/

# Secrets / API keys: NEVER commit plaintext credentials. The repo reads keys from
# the gitignored secrets/ dir, OS environment variables, or a gitignored .env file.
# Only the committed-safe .env.example documents the variable names.
secrets/
.env
.env.*
!.env.example
secrets.local.*
*.secret
# Decrypted output of an encrypted secrets file (SOPS/age/git-crypt), if used.
secrets.dec.*

# Derived view: rebuilt from experiments/logs/*.json shards via
# `experiment.py rebuild-log`. Source of truth is the per-experiment shards;
# this monolithic log is generated and must not be tracked (avoids the
# divergent-append merge conflicts that tracking it caused).
docs/experiment_log.jsonl

# Local same-machine agent-to-agent mailbox (scripts/agent_mailbox.py).
# Deliberately untracked: a tracked append-only chat would reintroduce the
# divergent-append merge conflicts retired with experiment_log.jsonl.
data/agent_mailbox/
