+    payload = {
+        "schema_version": 1,
+        "sleeve": "legacy",
+        "pending_entries": [{"decision_id": "pending-1", "ticker": "TOP"}],
+        "open_positions": [{"decision_id": "open-1", "ticker": "ALT"}],
+        "closed_positions": [{"decision_id": "closed-1", "ticker": "TOP"}],
+        "skipped_days": [{"decision_id": "skip-1", "date": "2026-01-05"}],
+    }
+    state_path.write_text(json.dumps(payload), encoding="utf-8")
+
+    migrated = load_accepted_helper_source_priority_allocator_state(state_path)
+
+    assert migrated["schema_version"] == STATE_SCHEMA_VERSION == 2
+    assert [row["decision_id"] for row in migrated["pending_entries"]] == [
