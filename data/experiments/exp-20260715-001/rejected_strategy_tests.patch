+def test_same_day_source_shadow_update_is_idempotent_and_detects_hash_conflict() -> None:
+    dates = _business_dates(1)
+    ohlcv = _shadow_ohlcv(dates, source_closes=[100.0])
+    state = empty_accepted_helper_source_priority_allocator_state()
+    kwargs = {
+        "state": state,
+        "as_of": dates[0],
+        "source_snapshots": {
+            "volatility_relief": _source_shadow_snapshot(
+                as_of=dates[0],
+                entry_date=dates[0],
+            )
+        },
+        "benchmark_ohlcv_by_ticker": ohlcv,
+        "config": {"source_quarantine_enabled": True},
+    }
+
+    update_source_relative_shadow_quarantine_state(
+        **kwargs,
+        ohlcv_by_ticker=ohlcv,
+    )
+    first = dict(state["source_quarantine"]["volatility_relief"])
+    update_source_relative_shadow_quarantine_state(
+        **kwargs,
+        ohlcv_by_ticker=ohlcv,
+    )
+    second = state["source_quarantine"]["volatility_relief"]
+    assert second["observation_sessions"] == first["observation_sessions"] == 1
+    assert second["last_input_hash"] == first["last_input_hash"]
+    assert second["available"] is True
+
+    changed_ohlcv = _shadow_ohlcv(dates, source_closes=[99.0])
+    update_source_relative_shadow_quarantine_state(
+        **kwargs,
+        ohlcv_by_ticker=changed_ohlcv,
+    )
+    conflict = state["source_quarantine"]["volatility_relief"]
+    assert conflict["observation_sessions"] == 1
+    assert conflict["available"] is False
+    assert conflict["unavailable_reason"] == "same_date_shadow_input_changed"
+
+    update_source_relative_shadow_quarantine_state(
+        **kwargs,
+        ohlcv_by_ticker=ohlcv,
+    )
+    latched = state["source_quarantine"]["volatility_relief"]
+    assert latched["observation_sessions"] == 1
+    assert latched["available"] is False
+    assert latched["unavailable_reason"] == "same_date_shadow_input_changed"
+    assert latched["input_conflict_date"] == dates[0]
+
