+            config={"source_quarantine_enabled": True},
+        )
+    assert state["source_quarantine"]["volatility_relief"]["quarantined"] is True
+
+    partial_recovery_date = dates[22]
+    update_source_relative_shadow_quarantine_state(
+        state=state,
+        as_of=partial_recovery_date,
+        source_snapshots={
+            "volatility_relief": _source_shadow_snapshot(
