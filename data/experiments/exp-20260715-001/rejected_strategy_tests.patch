+def test_source_quarantine_triggers_on_21st_not_20th_underwater_session() -> None:
+    dates = _business_dates(22)
+    ohlcv = _shadow_ohlcv(
+        dates,
+        source_closes=[100.0] + [99.0] * 21,
+    )
+    state = empty_accepted_helper_source_priority_allocator_state()
+
+    for idx, as_of in enumerate(dates):
+        update_source_relative_shadow_quarantine_state(
+            state=state,
+            as_of=as_of,
+            source_snapshots={
+                "volatility_relief": _source_shadow_snapshot(
+                    as_of=as_of,
+                    entry_date=dates[0],
