+def _shadow_ohlcv(
+    dates: list[str],
+    *,
+    source_closes: list[float],
+    spy_closes: list[float] | None = None,
+    qqq_closes: list[float] | None = None,
+) -> dict[str, list[dict]]:
+    """Build exact-date marks for deterministic source-health tests."""
+
+    assert len(source_closes) == len(dates)
+    spy_closes = spy_closes or [100.0] * len(dates)
+    qqq_closes = qqq_closes or [100.0] * len(dates)
+    assert len(spy_closes) == len(dates)
+    assert len(qqq_closes) == len(dates)
+
+    def rows(closes: list[float]) -> list[dict]:
+        return [
+            {
+                "date": day,
+                "open": 100.0,
+                "high": max(100.0, close),
+                "low": min(100.0, close),
+                "close": close,
+                "volume": 1_000_000,
+            }
+            for day, close in zip(dates, closes)
+        ]
+
+    return {
+        "TOP": rows(source_closes),
+        "ALT": rows([100.0] * len(dates)),
+        "SPY": rows(spy_closes),
+        "QQQ": rows(qqq_closes),
+    }
+
+
+def _source_shadow_snapshot(
+    *,
+    as_of: str,
+    entry_date: str,
+    source_family: str = "volatility_relief",
+    candidates: list[dict] | None = None,
+) -> dict:
+    return {
+        "asof_date": as_of,
+        "candidate_count": len(candidates or []),
+        "candidates": candidates or [],
+        "open_positions": [
+            {
+                "decision_id": f"{source_family}:TOP:{entry_date}",
+                "ticker": "TOP",
+                "entry_date": entry_date,
+            }
+        ],
+        "closed_positions": [],
+    }
+
+
+def _advance_shadow_days(
+    dates: list[str],
+    ohlcv: dict[str, list[dict]],
+    *,
+    source_family: str = "volatility_relief",
+) -> dict:
+    state = empty_accepted_helper_source_priority_allocator_state()
+    for as_of in dates:
+        update_source_relative_shadow_quarantine_state(
+            state=state,
+            as_of=as_of,
+            source_snapshots={
+                source_family: _source_shadow_snapshot(
+                    as_of=as_of,
+                    entry_date=dates[0],
+                    source_family=source_family,
+                )
+            },
+            ohlcv_by_ticker=ohlcv,
+            benchmark_ohlcv_by_ticker=ohlcv,
+            config={"source_quarantine_enabled": True},
+        )
+    return state
+
