+                entry_date=dates[0],
+            )
+        },
+        ohlcv_by_ticker=ohlcv,
+        benchmark_ohlcv_by_ticker=ohlcv,
+        config={"source_quarantine_enabled": True},
+    )
+    partial = state["source_quarantine"]["volatility_relief"]
+    assert partial["first_relative_equity"] >= partial["frozen_first_relative_hwm"]
+    assert partial["second_relative_equity"] < partial["frozen_second_relative_hwm"]
+    assert partial["quarantined"] is True
+    assert partial["recovered_today"] is False
+
+    recovered_date = dates[23]
+    update_source_relative_shadow_quarantine_state(
+        state=state,
+        as_of=recovered_date,
+        source_snapshots={
+            "volatility_relief": _source_shadow_snapshot(
