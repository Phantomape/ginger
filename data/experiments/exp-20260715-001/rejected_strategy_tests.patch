+                entry_date=dates[0],
+            )
+        },
+        ohlcv_by_ticker=ohlcv,
+        benchmark_ohlcv_by_ticker=ohlcv,
+        config={"source_quarantine_enabled": True},
+    )
+    recovered = state["source_quarantine"]["volatility_relief"]
+    assert recovered["quarantined"] is False
+    assert recovered["recovered_today"] is True
+    assert recovered["frozen_first_relative_hwm"] is None
+    assert recovered["frozen_second_relative_hwm"] is None
+
