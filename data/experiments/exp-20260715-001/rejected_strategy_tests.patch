+    ]
+    assert [row["decision_id"] for row in migrated["open_positions"]] == ["open-1"]
+    assert [row["decision_id"] for row in migrated["closed_positions"]] == [
+        "closed-1"
+    ]
+    assert migrated["skipped_days"] == payload["skipped_days"]
+    assert migrated["source_quarantine"] == {}
