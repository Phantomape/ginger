# Copy this file to `.env` and fill in real values. `.env` is gitignored; it is
# NEVER committed. Prefer setting these as real OS environment variables instead
# (e.g. Windows: `setx ORTEX_API_KEY "..."`), in which case you don't need a .env
# file at all. The .env file only exists as a fallback / for SOPS-decrypt output.

# ORTEX API key; manage keys at https://app.ortex.com/apis
# Public trial key for testing endpoints/paths is the literal string: TEST
ORTEX_API_KEY=

# Massive Stocks API key; manage keys in the Massive dashboard.
# Keep the real key in the environment (or a gitignored .env/secrets file), never here.
MASSIVE_API_KEY=
