#!/bin/sh
# Repository contract gate.
#
# The alpha-playbook check is fail-closed and reads the Git index, not the
# worktree. This makes partial staging deterministic: unstaged repairs cannot
# hide a bad staged document, and unstaged drafts cannot block a valid commit.
# The legacy self-registration check remains fail-open on tooling errors and
# blocks only confirmed new direct registry writers.

repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$repo_root" ] || ! cd "$repo_root"; then
  echo "Commit blocked: cannot resolve the repository root." >&2
  exit 1
fi

PY=""
if [ -x ".venv/Scripts/python.exe" ]; then
  PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
  PY=".venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PY="python3"
elif command -v python >/dev/null 2>&1; then
  PY="python"
fi

if [ -z "$PY" ]; then
  echo "Commit blocked: Python is required to validate the alpha playbook contract." >&2
  exit 1
fi

"$PY" -B scripts/alpha_playbook_guard.py --staged
status=$?
if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "Commit blocked by the alpha playbook contract guard." >&2
  echo "Fix the staged playbook/runner content and stage it again." >&2
  exit 1
fi

"$PY" -B scripts/self_registration_guard.py --staged
status=$?
if [ "$status" -eq 1 ]; then
  echo "" >&2
  echo "Commit blocked by the self-registration guard. Migrate the runner(s)" >&2
  echo "above off direct registry writes, or (deliberately) grandfather them" >&2
  echo "with: python scripts/refresh_self_register_allowlist.py --accept-new" >&2
  exit 1
fi

exit 0
