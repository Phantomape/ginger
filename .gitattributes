# LFS is reserved for files that exceed or approach GitHub's 100MB hard limit.
# Everything else stays as normal git blobs so working-tree files can never be
# silently replaced by unsmudged LFS pointers (see exp-20260611-027).
data/experiments/**/*.sqlite filter=lfs diff=lfs merge=lfs -text
data/warehouse/*.sqlite filter=lfs diff=lfs merge=lfs -text
# The hot-tier DB is gitignored (written every run, folded into cold via
# merge-hot). Unset the LFS filter so it is never accidentally force-added as a
# huge LFS object, and so git tooling does not hold it open during daily writes.
data/warehouse/warehouse_main_hot.sqlite !filter !diff !merge text=auto
data/kova/fundamentals/companyfacts_growth_broad_universe_*.jsonl filter=lfs diff=lfs merge=lfs -text
# docs/experiment_log.jsonl is retired: it was a perpetually-growing derived
# aggregate of experiments/logs/*.json (the source of truth). It is now untracked
# (.gitignore) and no longer written by append_log_entry; rebuild on demand with
# scripts/compact_experiment_records.py. Removing the LFS rule avoids re-adding a
# huge LFS object if it is ever force-tracked again.
# Git hooks are shell scripts: keep LF so the shebang works after checkout.
scripts/git-hooks/* text eol=lf
